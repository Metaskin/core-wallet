# Production API base URL — required for Capacitor (Android / iOS) native builds.
#
# Without this, the compiled app calls /api which resolves to https://localhost/api
# inside the Capacitor WebView. Capacitor serves index.html for that path → login
# gets an HTML response instead of JSON → "Unexpected server response" error.
#
# Steps:
#   1. Replace the placeholder below with your actual Render backend URL.
#   2. Run:  npm run build
#   3. Run:  npx cap sync android   (or ios)
#   4. Open in Android Studio / Xcode and build the APK / IPA.
#
# For Vercel web deployments, set VITE_API_URL in the Vercel dashboard
# (Project → Settings → Environment Variables) instead of in this file.
#
VITE_API_URL=https://core-wallet.onrender.com/api
