NODE_ENV=production
PORT=8080

# The URL your frontend is served from (Amplify domain).
# Used in CORS and in password-reset email links.
CLIENT_ORIGIN=https://your-amplify-app.amplifyapp.com

# ── Database ──────────────────────────────────────────────────────────────────
# Option A: single connection string (Elastic Beanstalk RDS auto-sets this)
DATABASE_URL=postgresql://user:password@your-rds-host.amazonaws.com:5432/corewallet

# Option B: individual vars (used when DATABASE_URL is not set)
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432
DB_NAME=corewallet
DB_USER=corewallet_user
DB_PASSWORD=your-secure-password

# Set to "true" when the DB requires SSL (always true for AWS RDS)
DB_SSL=true

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-64+-random-characters
JWT_EXPIRES_IN=7d

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key
ENABLE_EMAIL=true
# Must be a domain you have verified in Resend
EMAIL_FROM=CoreWallet <noreply@yourdomain.com>

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_MAX=20
FORGOT_RATE_LIMIT_MAX=5

# ── Transaction limits ────────────────────────────────────────────────────────
MAX_TRANSFER_AMOUNT=50000
MIN_TRANSFER_AMOUNT=0.01
