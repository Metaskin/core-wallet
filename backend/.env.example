NODE_ENV=production
PORT=8080

# Comma-separated list of allowed frontend origins.
# Supports: https://mctbank.online,https://www.mctbank.online,capacitor://localhost
CLIENT_ORIGIN=https://mctbank.online,https://www.mctbank.online,capacitor://localhost

# ── Database ──────────────────────────────────────────────────────────────────
# Option A: single connection string (Render/Neon auto-sets this)
DATABASE_URL=postgresql://user:password@your-db-host.neon.tech:5432/mctbank

# Option B: individual vars (used when DATABASE_URL is not set)
DB_HOST=your-db-host.neon.tech
DB_PORT=5432
DB_NAME=mctbank
DB_USER=mctbank_user
DB_PASSWORD=your-secure-password

# Set to "true" when the DB requires SSL (always true for Neon / AWS RDS)
DB_SSL=true

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-64+-random-characters
JWT_EXPIRES_IN=7d

# ── Email (Resend) ────────────────────────────────────────────────────────────
# Get your API key at https://resend.com/api-keys
# Verify mctbank.online in Resend dashboard → Domains
RESEND_API_KEY=re_your_resend_api_key
ENABLE_EMAIL=true
# Must match a domain verified in Resend (use mctbank.online after DNS setup)
EMAIL_FROM=MCT Bank <support@mctbank.online>

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_MAX=20
FORGOT_RATE_LIMIT_MAX=5

# ── Transaction limits ────────────────────────────────────────────────────────
MAX_TRANSFER_AMOUNT=50000
MIN_TRANSFER_AMOUNT=0.01
