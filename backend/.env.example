NODE_ENV=production
PORT=8080

# Comma-separated list of allowed frontend origins.
# Supports: https://mctbank.online,https://www.mctbank.online,capacitor://localhost
CLIENT_ORIGIN=https://mctbank.online,https://www.mctbank.online,http://localhost,http://localhost:5173

# ── Database ──────────────────────────────────────────────────────────────────
# Option A: single connection string (Render/Neon auto-sets this)
DATABASE_URL=postgresql://user:password@your-db-host.neon.tech:5432/mctbank

# Option B: individual vars (used when DATABASE_URL is not set)
DB_HOST=your-db-host.neon.tech
DB_PORT=5432
DB_NAME=mctbank
DB_USER=mctbank_user
DB_PASSWORD=your-secure-password

# Set to "true" when the DB requires SSL (always true for Neon / AWS RDS)
DB_SSL=true

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-64+-random-characters
JWT_EXPIRES_IN=7d

# ── Email (EmailJS) ───────────────────────────────────────────────────────────
# Docs: https://www.emailjs.com/docs/
# No domain verification needed — EmailJS delivers through your own email service.
ENABLE_EMAIL=true
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_PUBLIC_KEY=your_public_key_from_emailjs_account_settings
EMAILJS_PRIVATE_KEY=your_private_key_from_emailjs_account_settings
EMAILJS_TEMPLATE_ID=template_xxxxxxx
# Optional per-type overrides (fall back to EMAILJS_TEMPLATE_ID if unset):
# EMAILJS_TEMPLATE_WELCOME=template_xxxxxxx
# EMAILJS_TEMPLATE_RESET=template_xxxxxxx
# EMAILJS_TEMPLATE_TRANSACTION=template_xxxxxxx
# EMAILJS_TEMPLATE_LOGIN_ALERT=template_xxxxxxx

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10
REGISTER_RATE_LIMIT_MAX=20
FORGOT_RATE_LIMIT_MAX=5

# ── Transaction limits ────────────────────────────────────────────────────────
MAX_TRANSFER_AMOUNT=50000
MIN_TRANSFER_AMOUNT=0.01
